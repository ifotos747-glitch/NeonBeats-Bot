# Utworz nowa aplikacje Discord dla NeonBeats. Nie publikuj prywatnego pliku .env!
DISCORD_TOKEN=WPISZ_TOKEN_NOWEGO_BOTA
CLIENT_ID=WPISZ_NOWE_APPLICATION_ID
GUILD_ID=WPISZ_ID_SERWERA_DISCORD
# 0 = never leave the voice channel merely for idleness (recommended for permanent standby).
# A positive value (2-120) enables auto disconnect after that many idle minutes.
IDLE_MINUTES=0
# FFMPEG_PATH=/usr/bin/ffmpeg
# NEONBEATS_DATA_DIR=/home/container/data
# NEONBEATS_MUSIC_DIR=/home/container/music

# Discord ID właściciela bota do administracji globalnym katalogiem
BOT_OWNER_ID=WPISZ_DISCORD_USER_ID

# Opcjonalnie: istniejacy katalog tymczasowy yt-dlp (absolutna sciezka, zapisywalny, z wolnym miejscem i mozliwoscia wykonywania bibliotek)
# YTDLP_TMPDIR=/pelna/sciezka/do/katalogu

# 3.7 FASTSTREAM: network PCM jitter buffer in milliseconds (default 280; 0 disables; maximum 800)
# NEONBEATS_PREBUFFER_MS=280

# 3.7.3 RADIO JITTER GUARD: live-radio buffer runs throughout playback.
# Startup latency in milliseconds (0-3000); default 1000, try 1500 for unstable radio.
# The bot continuously tracks buffered PCM and detects interruptions in /status.
# NEONBEATS_RADIO_PREBUFFER_MS=1500

# NeonBeats 3.7.6: optional native Opus radio mode to compare stutter on ALTARE.
# PCM = current tested default; Opus = FFmpeg libopus -> Ogg -> Discord Voice.
# NEONBEATS_RADIO_CODEC=pcm
# Set NEONBEATS_RADIO_CODEC=opus, restart and check /status for OPUS NATYWNY.

# 3.7.7: Opus uses a bounded queue of real 20ms frames, not estimated Ogg bytes.
# NEONBEATS_RADIO_CODEC=opus

# 3.7.9: OPTIONAL robust live radio Opus transport: 96 kbps constrained VBR, 10% expected loss and FEC.
# Default 'standard' remains 128 kbps VBR; PCM and local files/YouTube unaffected.
# NEONBEATS_RADIO_OPUS_PROFILE=standard
# Enable A/B trial: NEONBEATS_RADIO_OPUS_PROFILE=robust

# 3.7.10 (optional) hold Opus at 96kbps CBR instead of robust constrained VBR.
# Keep NEONBEATS_RADIO_CODEC=opus; change only profile to robust-cbr for A/B comparison.
# NEONBEATS_RADIO_OPUS_PROFILE=robust-cbr
