{
  "name": "neonbeats",
  "main": "./worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "../website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/dashboard"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1471988860828516423",
    "PUBLIC_ORIGIN": "https://neonbeats.ifotos747.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neonbeats-control",
      "database_id": "1f60b232-f802-4c4a-8ffa-5330b3e11c22".
    }
  ]
}
